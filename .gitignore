# Git ignore for CreditWise
# ===========================

# Raw data — do not commit (may be large; download instructions in data/README.md)
data/raw/
data/processed/
*.zip
*.csv

# Trained model artefacts — generated by src/train.py
models/*.joblib
models/*.json

# Report outputs — generated, not source
reports/figures/
reports/results/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/

# Jupyter checkpoints
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Virtual environments
venv/
env/
.env/
.venv/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Distribution / packaging
dist/
build/
*.egg-info/
